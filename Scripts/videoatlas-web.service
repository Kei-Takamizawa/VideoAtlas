# systemd user unit for the VideoAtlas browser GUI.
# Install inside the server container (user dev):
#   mkdir -p ~/.config/systemd/user
#   cp Scripts/videoatlas-web.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now videoatlas-web
# To start it at boot without a login session, an administrator runs once:
#   sudo loginctl enable-linger dev
[Unit]
Description=VideoAtlas browser GUI (loopback only)

[Service]
Type=simple
WorkingDirectory=%h/videoatlas
ExecStart=%h/videoatlas/.venv/bin/python -m videoatlas.web serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
